# Copy to .env and fill in. Never commit the filled-in file.

# --- Database -------------------------------------------------------
# Matches docker-compose.yml (note port 5433, to avoid clashing with a
# PostgreSQL installed directly on the machine).
DATABASE_URL=postgresql+psycopg://duitakuh:duitakuh_dev@localhost:5433/duitakuh

# Separate database for integration tests. Tests create and drop tables,
# so this must NOT point at a database holding real data.
TEST_DATABASE_URL=postgresql+psycopg://duitakuh:duitakuh_dev@localhost:5433/duitakuh_test

# --- App ------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3033

# --- AI service (PRD section 13) -------------------------------------
# Self-hosted on `lumi-ai`. Both endpoints are OpenAI-compatible.
# These keys stay on the server and must never be sent to the PWA (AC21).
LLM_BASE_URL=https://llm.lumicore.co.id/v1
LLM_MODEL=qwen3.5-9b
LLM_API_KEY=

STT_BASE_URL=https://stt.lumicore.co.id/v1/audio/transcriptions
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
